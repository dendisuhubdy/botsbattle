DATABASE_URL=postgres://botsbattle:botsbattle@localhost:5434/botsbattle
TEST_DATABASE_URL=postgres://botsbattle:botsbattle@localhost:5434/botsbattle_test

# --- Tron (web + worker: watch-only) ---
TRON_NETWORK=nile
TRON_FULL_HOST=https://nile.trongrid.io
TRONGRID_API_KEY=
TRON_USDT_CONTRACT=
TRON_HOT_WALLET_ADDRESS=
# Derivation index of TRON_HOT_WALLET_ADDRESS under TRON_XPUB; must match the signer's seed.
TRON_HOT_WALLET_INDEX=0
TRON_XPUB=
TRON_CONFIRMATIONS=19
TRON_SWEEP_MIN_MICROS=20000000

# --- signer process ONLY. Never set this in web or worker. ---
TRON_MNEMONIC=

# 32 bytes of hex. Generate with: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=
