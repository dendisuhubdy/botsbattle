# Production environment for docker-compose.prod.yml.
#
# Copy to `.env.production` on the droplet, `chmod 600` it, and fill in every blank.
# Generate secrets on the droplet, not on a laptop:
#
#   openssl rand -hex 32   # TOTP_ENCRYPTION_KEY
#   openssl rand -hex 24   # POSTGRES_PASSWORD
#
# This file is a template and holds no secrets. `.env.production` is gitignored.

# --- database (internal to the compose network; `db` publishes no ports) ---
POSTGRES_USER=botsbattle
POSTGRES_PASSWORD=
POSTGRES_DB=botsbattle
# The host is `db`, the compose service name -- not localhost. Keep the password here in
# sync with POSTGRES_PASSWORD above.
DATABASE_URL=postgres://botsbattle:CHANGEME@db:5432/botsbattle

# --- Tron (mainnet) ---
TRON_NETWORK=mainnet
TRON_FULL_HOST=https://api.trongrid.io
TRONGRID_API_KEY=
# Mainnet USDT (TRC-20). NOT valid on Nile.
TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TRON_HOT_WALLET_ADDRESS=
# Derivation index of TRON_HOT_WALLET_ADDRESS under TRON_XPUB. The signer refuses to start
# unless this index actually derives TRON_HOT_WALLET_ADDRESS from TRON_MNEMONIC.
TRON_HOT_WALLET_INDEX=0
# Watch-only account xpub. web and worker derive deposit addresses from this; neither can spend.
TRON_XPUB=
TRON_CONFIRMATIONS=19
TRON_SWEEP_MIN_MICROS=20000000

# --- secrets ---
# 32 bytes of hex; encrypts TOTP secrets at rest. Rotating it invalidates every enrolment.
TOTP_ENCRYPTION_KEY=
# Signer container only. Never place this anywhere the web or worker can read -- worker/main.ts
# refuses to start if it is set, and the compose file omits it from web and worker deliberately.
# Only operational float belongs in this wallet; the remainder stays in cold storage.
TRON_MNEMONIC=

WORKER_INTERVAL_MS=15000
SIGNER_INTERVAL_MS=5000
