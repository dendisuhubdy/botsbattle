{
  "name": "botsbattle",
  "version": "1.0.0",
  "description": "Pari-mutuel betting on Robot MMA, settled in USDT",
  "private": true,
  "type": "module",
  "license": "ISC",
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:server": "tsc -p tsconfig.server.json && tsc-alias -p tsconfig.server.json -f",
    "start": "next start",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "tsx scripts/migrate.ts",
    "make-admin": "tsx scripts/make-admin.ts",
    "worker": "tsx worker/main.ts",
    "signer": "tsx signer/main.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@node-rs/argon2": "^2.0.2",
    "@scure/bip32": "^2.2.0",
    "@scure/bip39": "^2.2.0",
    "drizzle-orm": "^0.45.2",
    "next": "^15.5.21",
    "otpauth": "^9.5.1",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tronweb": "^6.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "fast-check": "^4.9.0",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
